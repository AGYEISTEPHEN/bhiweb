RewriteEngine On

# Force HTTPS and non-www together in a single redirect (fixes duplicate content issue)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.bonoheartinitiative\.org$ [NC]
RewriteRule ^(.*)$ https://bonoheartinitiative.org/$1 [L,R=301]

DirectoryIndex login.php index.php
# Hide .php extensions from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]